# Copie este arquivo para .env e preencha com os valores reais do seu
# projeto Supabase. Nunca commite o .env de verdade (ele já está no
# .gitignore).

# Painel do Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (Service Role) — usada SOMENTE pelo servidor
# (server/generateAndUploadPDF, uploadPDF). Nunca deve ir para o app/cliente.
SUPABASE_SERVICE_ROLE_KEY=

# URL base onde o servidor (server/_core/index.ts) está rodando, para o
# app conseguir chamar a API por trás de EXPO_PUBLIC_API_BASE_URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
